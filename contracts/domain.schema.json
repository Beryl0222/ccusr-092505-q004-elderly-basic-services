{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "基本养老服务资格网领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "NEED_ASSESSED",
        "ENTITLEMENT_GRANTED",
        "VISIT_ASSIGNED",
        "RISK_ESCALATED",
        "SERVICE_FULFILLED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "elder_profile",
        "service_entitlement",
        "care_facility",
        "visit_record"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
