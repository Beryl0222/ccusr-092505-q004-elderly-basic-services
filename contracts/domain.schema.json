{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "基本养老服务资格网领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "JURISDICTION_REGISTERED",
        "CATALOG_PUBLISHED",
        "RESPONSIBILITY_ASSIGNED",
        "FACILITY_REGISTERED",
        "FACILITY_CLOSED",
        "CAREGIVER_REGISTERED",
        "ELDER_REGISTERED",
        "CONSENT_GRANTED",
        "CONSENT_WITHDRAWN",
        "ELDER_RELOCATED",
        "NEED_ASSESSED",
        "ENTITLEMENT_GRANTED",
        "APPOINTMENT_SCHEDULED",
        "APPOINTMENT_REASSIGNED",
        "APPOINTMENT_CANCELLED",
        "VISIT_ASSIGNED",
        "SERVICE_FULFILLED",
        "RISK_ESCALATED",
        "EMERGENCY_REFERRAL",
        "MATERIALS_COMPLETED",
        "ESCALATION_RESOLVED",
        "REPORT_CONFLICT"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "jurisdiction",
        "service_catalog",
        "care_facility",
        "caregiver",
        "elder_profile",
        "service_entitlement",
        "appointment",
        "visit_record",
        "report_conflict"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
