{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "基本养老服务资格网领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "NEED_ASSESSED",
        "ENTITLEMENT_GRANTED",
        "VISIT_ASSIGNED",
        "RISK_ESCALATED",
        "SERVICE_FULFILLED",
        "PAPERWORK_COMPLETED",
        "POLICY_PUBLISHED",
        "ELDER_REGISTERED",
        "ELDER_RELOCATED",
        "CONSENT_GRANTED",
        "CONSENT_WITHDRAWN",
        "ENTITLEMENT_REVOKED",
        "FACILITY_REGISTERED",
        "FACILITY_SUSPENDED",
        "FACILITY_RESUMED",
        "CAREGIVER_REGISTERED",
        "SERVICE_REQUESTED",
        "APPOINTMENT_SCHEDULED",
        "APPOINTMENT_RESCHEDULED",
        "APPOINTMENT_CANCELLED",
        "EMERGENCY_TRIGGERED",
        "REFERRAL_OPENED",
        "REFERRAL_CLOSED",
        "SUBMISSION_ACCEPTED",
        "SUBMISSION_DUPLICATE_RETURNED",
        "REVIEW_OPENED",
        "REVIEW_RESOLVED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "elder_profile",
        "service_entitlement",
        "care_facility",
        "visit_record",
        "policy_catalog",
        "service_catalog",
        "appointment",
        "referral_case",
        "provider_submission",
        "review_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
